diff --git a/include/lapack.h b/include/lapack.h
new file mode 100755
index 0000000..49308a0
--- /dev/null
+++ b/include/lapack.h
@@ -0,0 +1,93 @@
+/*
+    lapack.h  --  minimal LAPACK shim supplying the one routine cuADMM needs.
+
+    WHY THIS FILE EXISTS
+    include/cuadmm/eig_cpu.h does  #include <lapack.h>  and calls dsyevd passing
+    ptrdiff_t* for every integer argument.  That is MATLAB's lapack.h convention
+    (64-bit LAPACK integers).  Ubuntu ships no lapack.h at all: liblapack64-dev is
+    library-only and lapack.h lives in the lapacke packages.  dsyevd is the ONLY
+    LAPACK routine referenced anywhere in cuADMM's src/ or include/.
+
+    WHY NOT LINK THE ILP64 LIBRARY (liblapack64), which would need no conversion:
+    libcholmod.so has NEEDED liblapack.so.3, and both that (OpenBLAS) and
+    liblapack64.so.3 export dsyevd_ under the SAME unsuffixed name with different
+    integer widths.  Loading both puts two ABIs behind one symbol; whichever the
+    loader picks also interposes on CHOLMOD's own LAPACK calls, corrupting the
+    sparse Cholesky of A*A' that cuADMM depends on.  A mixed-ABI process is the
+    more dangerous option, so we keep ONE LAPACK -- the LP64 OpenBLAS already in
+    the link -- and narrow explicitly here.
+
+    Narrowing is safe because it is checked, not assumed: dsyevd's largest
+    argument is lwork = 1 + 6N + 2N^2, which exceeds INT_MAX only past N ~ 32768,
+    far above the PSD blocks of the SDPs measured (largest N = 2856).  The guard
+    below aborts rather than truncating, so the failure is never silent.
+*/
+
+#ifndef CUADMM_LAPACK_SHIM_H
+#define CUADMM_LAPACK_SHIM_H
+
+#include <stddef.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* LP64 LAPACK: integers are 32-bit. Resolved from libopenblas/liblapack.so.3. */
+void dsyevd_(
+    const char* jobz, const char* uplo,
+    const int* n, double* a, const int* lda,
+    double* w,
+    double* work, const int* lwork,
+    int* iwork, const int* liwork,
+    int* info);
+
+#ifdef __cplusplus
+}
+#endif
+
+/* Checked ptrdiff_t -> int narrowing. */
+static inline int cuadmm_lapack_narrow(ptrdiff_t v, const char* what)
+{
+    if (v > (ptrdiff_t)INT_MAX || v < -(ptrdiff_t)INT_MAX) {
+        fprintf(stderr,
+            "cuADMM lapack shim: %s = %td exceeds the 32-bit LAPACK range. "
+            "Rebuild against an ILP64 LAPACK whose symbols are suffixed "
+            "(e.g. dsyevd_64_) so it cannot collide with CHOLMOD's LP64 LAPACK.\n",
+            what, v);
+        abort();
+    }
+    return (int)v;
+}
+
+/* eig_cpu.h calls the unsuffixed name with ptrdiff_t* arguments. Bridge to the
+   LP64 entry point; iwork and info are ptrdiff_t arrays on the caller's side, so
+   they need a staged int buffer, not a cast. */
+static inline void dsyevd(
+    const char* jobz, const char* uplo,
+    const ptrdiff_t* n, double* a, const ptrdiff_t* lda,
+    double* w,
+    double* work, const ptrdiff_t* lwork,
+    ptrdiff_t* iwork, const ptrdiff_t* liwork,
+    ptrdiff_t* info)
+{
+    const int n_i     = cuadmm_lapack_narrow(*n,      "n");
+    const int lda_i   = cuadmm_lapack_narrow(*lda,    "lda");
+    const int lwork_i = cuadmm_lapack_narrow(*lwork,  "lwork");
+    const int liwork_i= cuadmm_lapack_narrow(*liwork, "liwork");
+    int info_i = 0;
+
+    /* iwork is a genuine int32 array to LAPACK. The caller allocated liwork
+       ptrdiff_t slots = 2x the bytes needed, so the front half is reusable as
+       int storage without a separate allocation. */
+    int* iwork_i = (int*)iwork;
+
+    dsyevd_(jobz, uplo, &n_i, a, &lda_i, w, work, &lwork_i,
+            iwork_i, &liwork_i, &info_i);
+
+    *info = (ptrdiff_t)info_i;
+}
+
+#endif /* CUADMM_LAPACK_SHIM_H */
