\begin{tabular}{>{\raggedright\arraybackslash}p{1.4cm}>{\raggedright\arraybackslash}p{4.2cm}>{\raggedright\arraybackslash}p{4.2cm}>{\raggedright\arraybackslash}p{5.1cm}}
\toprule
setting & factor of the certificate & zero means & today \\
\midrule
$d_1$ & incomplete moments, block $\bc$ of \eqref{eq:lift} & no block $\bc$; $K$ a polynomial on the square & \code{mult} cap of the lower and upper operators, $+1$; \code{sep} drops them \\
$d_2$ & complete moments, block $\bb$ & no block $\bb$ & \code{mult} cap of the full operator, $+1$ (\code{sep}); else of the upper one \\
$d_{3\ba}$ & multiplier length of block $\ba$ & no multiplier $M$ & \code{mult} of \code{lpi.pos}, $+1$ \\
$d_{3\bb},d_{3\bc}$ & multiplier lengths of blocks $\bb$, $\bc$ & the block absent & \code{int} of \code{lpi.pos}, $+1$ \\
